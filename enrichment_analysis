############################################################################################################################

#### FUNCTIONAL PATHWAY ENRICHMENT ANALYSIS ####

setwd("/path/to/variant/data")

# 1. LOADING PACKAGES AND VARIANTS DATA

library(clusterProfiler)
library(msigdbr)
library(org.Hs.eg.db)
library(dplyr)
library(ggplot2)
library(enrichplot)

variants <- read_excel("my_variants.xlsx")

# 2. PRE-PROCESSING VARIANTS AND REMOVING 'INTERGENIC' VARIANTS

hall_genes <- variants %>%
  filter(!is.na(Gene.refGene) & Gene.refGene != "Intergenic") %>%
  pull(Gene.refGene) %>%
  unique()

# 3. DOWNLOADING MSIGDB 'HALLMARKS' DATASET

hallmark_sets <- msigdbr(species = "Homo sapiens", collection = "H") %>%
  dplyr::select(gs_name, gene_symbol)

# 4. RUNNING PATHWAY ENRICHMENT ANALYSIS BY OVER-REPRESENTATION ANALYSIS (ORA)

enrichment_hallmarks <- enricher(
  gene = hall_genes,
  TERM2GENE = hallmark_sets,
  pvalueCutoff = 0.05,  
  pAdjustMethod = "BH" #Benjamini-Hochberg (FDR)
)

hallmarks <- as.data.frame(enrichment_hallmarks)

# 5. PLOTTING ENRICHMENT ANALYSIS RESULTS

enrichment_hallmark_result <- dotplot(enrichment_hallmarks, showCategory = 10, font.size = 11) +
  scale_y_discrete(labels = function(x) gsub("HALLMARK_", "", x)) + 
  labs(
    title = "Hallmark Pathway Enrichment Analysis (MSigDB)",
    subtitle = "Statistically significant pathways (adjusted p-value < 0.05)",
    x = "Gene proportion",
    color = "adjusted p-value",
    size = "Counting"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 13),
    axis.text = element_text(color = "black", size = 10),
    axis.title = element_text(face = "bold", size = 11)
  )
print(enrichment_hallmark_result)

ggsave("enrichment_hallmark.png", plot = enrichment_hallmark, width = 7, height = 5, dpi = 300)
